# Copy to .env for local development. Vite loads it and bakes VITE_* values
# into the client bundle at build time. At deploy, pass the same names as
# Docker build args instead. Every value is optional locally.

# --- Backend API ---
# Defaults to http://localhost:3000.
VITE_API_URL=http://localhost:3000

# --- Crash reporting (GlitchTip, via the Sentry SDK) ---
# Leave VITE_SENTRY_DSN empty to disable reporting entirely.
VITE_SENTRY_DSN=
# Environment tag shown in GlitchTip.
VITE_SENTRY_ENVIRONMENT=development
# Fraction of transactions traced (0.0–1.0). Defaults to 0.0 (off).
VITE_SENTRY_TRACES_SAMPLE_RATE=0.0

# --- Source-map upload (Docker build args at deploy, not this file) ---
# Runs only when SENTRY_AUTH_TOKEN is set. The token is a build ARG, so it is
# not kept in the image, and .map files are deleted before the nginx stage.
# SENTRY_URL, SENTRY_AUTH_TOKEN, SENTRY_ORG, SENTRY_PROJECT
